#!/usr/bin/env bash

#  shellcheck enable=require-variable-braces  ## Every expansion braced: "${var}", not "$var".

##	Purpose:
##		- Runs the merge gate before a push to main, and stops the push if it fails.
##		- A push to main whose commits change only the paths in cicd/docs-only-paths skips the gate.
##		  A push to dev or a feature branch is never held up.
##		- Install with: ln -s ../../cicd/hooks/pre-push .git/hooks/pre-push
##		- CICD_MERGE_GATE_CMD names another command to run in place of the gate, for a test.
##	History: At bottom of script.

##	Copyright © 2026 t00mietum (CryptogID: ปʬϝღถɔ4რఠΔթะ9ƾǝu)
##	Licensed under the GNU General Public License v2.0 or later. Full text at:
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

here="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
root="$(cd "${here}/../.." && pwd)"
gate=("${root}/cicd/cicd.bash" --merge-gate)
[[ -z "${CICD_MERGE_GATE_CMD:-}" ]] || read -r -a gate <<< "${CICD_MERGE_GATE_CMD}"

fOnlyDocs(){ ## FROM TO: true when every changed path matches the list
	local from="$1" to="$2" f g ok pats=() range
	while IFS= read -r g; do [[ -z "${g}" || "${g}" == \#* ]] || pats+=("${g}"); done < "${root}/cicd/docs-only-paths"
	if [[ "${from}" =~ ^0+$ ]]; then range="${to}"; else range="${from}..${to}"; fi
	local n=0
	while IFS= read -r f; do
		n=$((n + 1)); ok=0
		# shellcheck disable=SC2053  ## the pattern is a glob on purpose
		for g in "${pats[@]}"; do [[ "${f}" == ${g} ]] && { ok=1; break; }; done
		((ok)) || return 1
	done < <(git -C "${root}" diff --name-only "${range}" 2>/dev/null || echo __unknown__)
	((n > 0))
}

while read -r _ localSha remoteRef remoteSha; do
	[[ "${remoteRef}" == refs/heads/main ]] || continue
	[[ ! "${localSha}" =~ ^0+$ ]] || continue
	if fOnlyDocs "${remoteSha}" "${localSha}"; then
		printf 'pre-push: only docs change on main, so the merge gate is skipped\n' >&2
		continue
	fi
	printf 'pre-push: running the merge gate before the push to main\n' >&2
	"${gate[@]}" || { printf 'pre-push: the merge gate failed, so nothing was pushed\n' >&2; exit 1; }
done
exit 0


##	History:
##		- 2026-11-12: Created.
