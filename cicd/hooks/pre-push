#!/usr/bin/env bash

#  shellcheck enable=require-variable-braces  ## Every expansion braced: "${var}", not "$var".

##	Purpose:
##		- Runs the merge gate before a push to main, and stops the push if it fails.
##		- A push of the commit that cicd/cicd.bash --merge-gate last passed on, with a clean tree,
##		  skips it. A gate run inside the hook takes long enough that GitHub can drop the push's connection.
##		- A push to main whose commits change only the paths in cicd/docs-only-paths runs the quick gate
##		  in its place, without CodeQL, in about a minute. markdownlint reads every doc, and the config
##		  tests read design.md, so a docs push can still break the next gate on main.
##		- A push to dev or a feature branch is never held up.
##		- Install with: ln -s ../../cicd/hooks/pre-push .git/hooks/pre-push
##		- CICD_MERGE_GATE_CMD and CICD_DOCS_GATE_CMD name other commands to run in place of the 2 gates,
##		  for a test.
##	History: At bottom of script.

##	Copyright © 2026 t00mietum (CryptogID: ปʬϝღถɔ4რఠΔթะ9ƾǝu)
##	Licensed under the GNU General Public License v2.0 or later. Full text at:
##		https://spdx.org/licenses/GPL-2.0-or-later.html
##	SPDX-License-Identifier: GPL-2.0-or-later


set -euo pipefail

here="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
root="$(cd "${here}/../.." && pwd)"
gate=("${root}/cicd/cicd.bash" --merge-gate)
docsGate=("${root}/cicd/cicd.bash" --backlog-run-quick --no-codeql)
[[ -z "${CICD_MERGE_GATE_CMD:-}" ]] || read -r -a gate <<< "${CICD_MERGE_GATE_CMD}"
[[ -z "${CICD_DOCS_GATE_CMD:-}" ]] || read -r -a docsGate <<< "${CICD_DOCS_GATE_CMD}"

fOnlyDocs(){ ## FROM TO: true when every changed path matches the list
	local from="$1" to="$2" f g ok pats=()
	## A push that makes the branch has no old commit to diff from, so it gets the merge gate.
	[[ ! "${from}" =~ ^0+$ ]] || return 1
	while IFS= read -r g; do [[ -z "${g}" || "${g}" == \#* ]] || pats+=("${g}"); done < "${root}/cicd/docs-only-paths"
	local n=0
	while IFS= read -r f; do
		n=$((n + 1)); ok=0
		# shellcheck disable=SC2053  ## the pattern is a glob on purpose
		for g in "${pats[@]}"; do [[ "${f}" == ${g} ]] && { ok=1; break; }; done
		((ok)) || return 1
	done < <(git -C "${root}" diff --name-only "${from}..${to}" 2>/dev/null || echo __unknown__)
	((n > 0))
}

while read -r _ localSha remoteRef remoteSha; do
	[[ "${remoteRef}" == refs/heads/main ]] || continue
	[[ ! "${localSha}" =~ ^0+$ ]] || continue
	if [[ "$(cat "${root}/cicd/artifacts/merge-gate-passed" 2>/dev/null || true)" == "${localSha}" ]]; then
		printf "pre-push: the merge gate already passed on %s, so it's skipped\n" "${localSha:0:12}" >&2
		continue
	fi
	if fOnlyDocs "${remoteSha}" "${localSha}"; then
		printf 'pre-push: only docs change on main, so the quick gate runs in place of the merge gate\n' >&2
		"${docsGate[@]}" || { printf 'pre-push: the quick gate failed, so nothing was pushed\n' >&2; exit 1; }
		continue
	fi
	printf 'pre-push: running the merge gate before the push to main. If the push then fails with no message, run cicd/cicd.bash --merge-gate first, then push.\n' >&2
	"${gate[@]}" || { printf 'pre-push: the merge gate failed, so nothing was pushed\n' >&2; exit 1; }
done
exit 0


##	History:
##		- 2026-11-12: Created.
##		- 2026-11-14: Skips the gate for the commit a merge gate already passed on.
##		- 2026-11-18: A docs-only push runs the quick gate, since docs are read by lint and tests.
##		- 2026-11-20: A push that makes main always runs the merge gate, rather than diffing against the working tree.
